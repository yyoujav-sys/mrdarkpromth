RUST_LOG=info

# Configuration
CONFIG_ENV=development

# Agent Coordination
AGENT_COORDINATION_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=30
MEMORY_LOG_ENABLED=true

# Sandbox execution
SANDBOX_USE_DOCKER=false
