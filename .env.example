CEREBRAS_API_KEYS=
CEREBRAS_DEFAULT_MODEL=llama-3.3-70b

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_SECRET=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mr_darkpromth
