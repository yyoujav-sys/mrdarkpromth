# MR.DarkPromth Agent 4 Dockerfile
# Jailbreak & Ultra Tier Engineer

FROM --platform=linux/amd64 rust:1.75 as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Cargo files
COPY Cargo.toml Cargo.lock ./
COPY mr_darkpromth/Cargo.toml ./mr_darkpromth/
COPY mr_darkpromth/services/Cargo.toml ./mr_darkpromth/services/

# Create source directory structure
RUN mkdir -p src mr_darkpromth/services/src

# Copy source code
COPY src ./src/
COPY mr_darkpromth/src ./mr_darkpromth/src/
COPY mr_darkpromth/services/src ./mr_darkpromth/services/src/

# Build the application
RUN cargo build --release

# Runtime stage
FROM --platform=linux/amd64 debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libpq5 \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 agent4

# Set working directory
WORKDIR /app

# Copy the binary from builder stage
COPY --from=builder /app/target/release/mr_darkpromth_services /usr/local/bin/agent4

# Copy configuration files
COPY .env.example .env

# Create necessary directories
RUN mkdir -p /app/memory /app/logs

# Change ownership to agent4 user
RUN chown -R agent4:agent4 /app

# Switch to agent4 user
USER agent4

# Expose port
EXPOSE 8084

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8084/health || exit 1

# Set environment variables
ENV RUST_LOG=info
ENV AGENT_ID=agent4
ENV PORT=8084

# Run the application
CMD ["agent4"]
