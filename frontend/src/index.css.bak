@tailwind base;
@tailwind components;
@tailwind utilities;

/* Base styles */
body {
  background-color: #0a0a0a;
  color: #ffffff;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  line-height: 1.6;
  overflow-x: hidden;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #1a1a1a;
}

::-webkit-scrollbar-thumb {
  background: #ff006e;
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: #fb5607;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  background: linear-gradient(135deg, #ff006e 0%, #fb5607 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 1rem;
}

h1 { font-size: 3rem; }
h2 { font-size: 2.5rem; }
h3 { font-size: 2rem; }
h4 { font-size: 1.5rem; }
h5 { font-size: 1.25rem; }
h6 { font-size: 1rem; }

p {
  color: #b0b0b0;
  margin-bottom: 1rem;
}

/* Animation utilities */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(255, 0, 110, 0.7);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(255, 0, 110, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(255, 0, 110, 0);
  }
}

@keyframes glow {
  0% { box-shadow: 0 0 20px rgba(139, 92, 246, 0.5); }
  100% { box-shadow: 0 0 30px rgba(139, 92, 246, 0.8); }
}

/* Utility classes */
.pulse {
  animation: pulse 2s infinite;
}

.glow {
  box-shadow: 0 0 20px rgba(255, 0, 110, 0.3);
}

.neon-border {
  border: 1px solid rgb(139 92 246 / 0.3);
  box-shadow: 0 10px 15px -3px rgb(139 92 246 / 0.2);
}

.glass-effect {
  background-color: rgb(42 42 42 / 0.8);
  backdrop-filter: blur(12px);
}

.gradient-text {
  background-image: linear-gradient(to right, rgb(139 92 246), rgb(59 130 246));
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
}

/* Card styles */
.card {
  background: #1e1e1e;
  border: 1px solid #333333;
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  transition: 0.3s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  border-color: #ff006e;
}

/* Dashboard grid */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  padding: 2rem;
}

/* Stat card */
.stat-card {
  background: #1e1e1e;
  border: 1px solid #333333;
  border-radius: 12px;
  padding: 24px;
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(135deg, #ff006e 0%, #fb5607 100%);
}

.stat-value {
  font-size: 2.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #ff006e 0%, #fb5607 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  color: #b0b0b0;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Loading spinner */
.loading-spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #2a2a2a;
  border-top: 4px solid #ff006e;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* Responsive */
@media (max-width: 768px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
    padding: 1rem;
  }
  
  h1 { font-size: 2rem; }
  h2 { font-size: 1.5rem; }
  h3 { font-size: 1.25rem; }
}
