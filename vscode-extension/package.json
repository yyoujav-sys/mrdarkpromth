{
  "name": "mr-darkpromth",
  "displayName": "MR.DarkPromth",
  "description": "AI-powered chat interface with jailbreak capabilities integrated into VS Code",
  "version": "1.0.0",
  "publisher": "mr-darkpromth",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mr-darkpromth.openChat",
    "onCommand:mr-darkpromth.authenticate",
    "onView:mr-darkpromth-sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mr-darkpromth.openChat",
        "title": "Open MR.DarkPromth Chat",
        "category": "MR.DarkPromth"
      },
      {
        "command": "mr-darkpromth.authenticate",
        "title": "Authenticate with MR.DarkPromth",
        "category": "MR.DarkPromth"
      },
      {
        "command": "mr-darkpromth.clearChat",
        "title": "Clear Chat History",
        "category": "MR.DarkPromth"
      },
      {
        "command": "mr-darkpromth.refreshUserInfo",
        "title": "Refresh User Information",
        "category": "MR.DarkPromth"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mr-darkpromth-container",
          "title": "MR.DarkPromth",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mr-darkpromth-container": [
        {
          "type": "webview",
          "id": "mr-darkpromth-sidebar",
          "name": "Chat",
          "when": "mr-darkpromth.authenticated"
        }
      ]
    },
    "configuration": {
      "title": "MR.DarkPromth",
      "properties": {
        "mr-darkpromth.apiEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "The API endpoint for MR.DarkPromth backend"
        },
        "mr-darkpromth.theme": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "auto"
          ],
          "default": "auto",
          "description": "Theme for the chat interface"
        },
        "mr-darkpromth.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for updates"
        },
        "mr-darkpromth.maxHistoryLength": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of messages to keep in chat history"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "typescript": "^4.9.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jsonwebtoken": "^9.0.0",
    "redis": "^5.10.0"
  }
}
